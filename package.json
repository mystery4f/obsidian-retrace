{
	"name": "obsidian-retrace",
	"version": "0.1.0",
	"description": "IDEA-style recent files, recent locations and outline jump for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --outdir=.tmp/test --log-level=warning && node --test \".tmp/test/*.test.js\""
	},
	"keywords": [
		"obsidian",
		"recent-files",
		"recent-locations",
		"outline",
		"navigation"
	],
	"author": "mystery4f",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.2",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2"
	}
}
